+
+void AnkiActivity::provideMenuRow(void* const ctx, const uint16_t index, fui::ListItem& row) {
+  auto& self = *static_cast<AnkiActivity*>(ctx);
+  if (index >= self.menuItems.size()) return;
+  const MenuItem& item = self.menuItems[index];
+
+  self.menuLabelScratch.clear();
+  self.menuSubtitleScratch.clear();
+  self.menuValueScratch.clear();
+  if (item.action == MenuAction::DECK) {
+    const AnkiDeckInfo info = ANKI_STORE.getDeckInfo(item.deckIndex);
+    if (!info.name.empty() && info.name != "Anki") {
+      self.menuLabelScratch = info.name;
+    } else if (!info.id.empty() && info.id != "default" && info.id != "Anki") {
+      if (info.id.rfind("name:", 0) == 0 && info.id.size() > 5) {
+        self.menuLabelScratch = info.id.substr(5);
+      } else if (info.id[0] < '0' || info.id[0] > '9') {
+        self.menuLabelScratch = info.id;
+      }
+    }
+    if (self.menuLabelScratch.empty() && !info.name.empty()) self.menuLabelScratch = info.name;
+    if (self.menuLabelScratch.empty()) {
+      char fallback[28];
+      snprintf(fallback, sizeof(fallback), "%s %u", tr(STR_ANKI_LEARN),
+               static_cast<unsigned int>(item.deckIndex + 1));
+      self.menuLabelScratch = fallback;
+    }
+
+    const uint16_t total = info.total > 0 ? info.total : info.remaining;
+    if (total == 0 || info.remaining == 0) {
+      self.menuSubtitleScratch = tr(STR_ANKI_DECK_FINISHED);
+    } else {
+      const unsigned pct =
+          static_cast<unsigned>((static_cast<uint32_t>(total - info.remaining) * 100u) / total);
+      char progress[40];
+      snprintf(progress, sizeof(progress), tr(STR_ANKI_PROGRESS_FORMAT), static_cast<unsigned int>(info.remaining),
+               static_cast<unsigned int>(total), pct);
+      self.menuSubtitleScratch = progress;
+    }
+    char value[48];
+    snprintf(value, sizeof(value), tr(STR_ANKI_REMAINING_FORMAT), static_cast<unsigned int>(info.remaining));
+    self.menuValueScratch = value;
+  } else {
+    self.menuLabelScratch = staticMenuLabel(item.action);
+    if (item.action == MenuAction::LEARN) {
+      char value[48];
+      snprintf(value, sizeof(value), tr(STR_ANKI_REMAINING_FORMAT),
+               static_cast<unsigned int>(ANKI_STORE.getRemainingCount()));
+      self.menuValueScratch = value;
+    } else if (item.action == MenuAction::UPLOAD) {
+      const unsigned reviews = static_cast<unsigned>(ANKI_STORE.getReviewCount());
+      const unsigned flags = static_cast<unsigned>(ANKI_STORE.getPendingFlagCount());
+      char value[48];
+      if (flags > 0 && reviews > 0) {
+        snprintf(value, sizeof(value), "%u+%u", reviews, flags);
+      } else if (flags > 0) {
+        snprintf(value, sizeof(value), "F%u", flags);
+      } else {
+        snprintf(value, sizeof(value), "%u", reviews);
+      }
+      self.menuValueScratch = value;
+    }
+  }
+
+  row.label = self.menuLabelScratch.c_str();
+  row.subtitle = self.menuSubtitleScratch.empty() ? nullptr : self.menuSubtitleScratch.c_str();
+  row.value = self.menuValueScratch.empty() ? nullptr : self.menuValueScratch.c_str();
+  row.actionValue = static_cast<int16_t>(index);
+}
