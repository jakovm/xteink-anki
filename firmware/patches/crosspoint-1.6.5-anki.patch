+  uint16_t total = 0;
+};
+
+class AnkiStore {
+ public:
+  static constexpr const char* PULL_TEMP_PATH = "/.crosspoint/anki-pull.tmp";
+  static constexpr const char* FLAGS_PATH = "/.crosspoint/anki-flags.csv";
+  static constexpr const char* PUSH_TEMP_PATH = "/.crosspoint/anki-push.json";
