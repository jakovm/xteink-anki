+++ b/src/activities/anki/AnkiActivity.cpp
@@ -0,0 +1,2076 @@
+#include "AnkiActivity.h"
+
+#include "../../anki/AnkiFirmwareVersion.h"
+#include <EpdFontData.h>
+#include <EpdFontFamily.h>
+#include <GfxRenderer.h>
